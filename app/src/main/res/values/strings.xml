    <string name="settings_battery_usage_huawei_steps">1. Search for \"Battery\" in the settings.\n2. Locate Floating Dock and turn off \"Auto-Manage\".</string>
    <string name="settings_battery_usage_huawei_title">HUAWEI/HONOR</string>
    <string name="settings_battery_usage_intro">The setting item name or path may be different for different models or phones of the same model. The specific procedure depends on the actual device content.</string>
    <string name="settings_battery_usage_miui_steps">1. Search \"Power Saving and Battery &gt; Settings &gt; Apply Smart Power Saving\" in Settings.\n2. Find Floating Dock and select \"Unlimited\" in the background configuration.</string>
    <string name="settings_battery_usage_miui_title">MIUI</string>
    <string name="settings_battery_usage_motorola_steps">Open Settings, then tap Battery &gt; Battery Manager and Battery Saver, and ensure both toggles are turned off.</string>
    <string name="settings_battery_usage_motorola_title">Motorola</string>
    <string name="settings_battery_usage_oneplus_steps">1. Search for \"Battery\" in the settings, go to it, and find \"Battery Saver Mode\".\n2. Locate Floating Dock and turn off the Battery Saver mode toggle.</string>
    <string name="settings_battery_usage_oneplus_title">OnePlus</string>
    <string name="settings_battery_usage_oppo_steps">1. Search for \"Battery &gt; Application Power Management\" in the settings.\n2. Locate Floating Dock and enable \"Allow wake-up foreground\" and \"Allow full background behaviour\".</string>
    <string name="settings_battery_usage_oppo_title">OPPO</string>
    <string name="settings_battery_usage_pixel_steps">1. Open Settings, tap Battery, and navigate to Battery Usage.\n2. In the app list, locate Floating Dock and enable Allow Background Usage.</string>
    <string name="settings_battery_usage_pixel_title">Pixel</string>
    <string name="settings_battery_usage_realme_steps">1. Search for \"Battery\" in the settings, then go to Battery &gt; Power Saving Settings &gt; App Power Management.\n2. Locate Floating Dock, disable Auto Optimisation, and select No Restrictions.</string>
    <string name="settings_battery_usage_realme_title">realme</string>
    <string name="settings_battery_usage_redmi_steps">1. Search for Battery Saver &amp; Battery in the settings.\n2. Locate Floating Dock in the app list, tap on App Info, find Battery Saver Policy, and select No Restrictions.</string>
    <string name="settings_battery_usage_redmi_title">Redmi</string>
    <string name="settings_battery_usage_samsung_steps">1. Search for \"Battery\" in Settings.\n2. Tap Battery, then locate and select Optimise Battery Usage.\n3. Find Floating Dock and toggle off the switch.</string>
    <string name="settings_battery_usage_samsung_title">Samsung</string>
    <string name="settings_battery_usage_section_title">App battery usage</string>
    <string name="settings_battery_usage_vivo_steps">1. Search for \"Battery &gt; Background power consumption management\" in the settings.\n2. Locate Floating Dock and toggle the switch on the right to enable it.</string>
    <string name="settings_battery_usage_vivo_title">vivo/iQOO</string>
